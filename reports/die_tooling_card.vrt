        },
        {
          "Class": "TReportTextObject",
          "Name": "boxSec1Body",
          "Bounds": { "L": 0, "T": 30, "R": 355, "B": 170 },
          "Visible": true,
          "Text": "Customer: [CUSTOMER_NAME] ([CUSTOMER_CODE])\nCustomer Ref: [CUSTOMER_REF]\nTooling Shape: [SHAPE]\nCut Type: [CUT_TYPE]\nOperational Status: [STATUS_NAME]\nGap Policy Status: [GAP_POLICY_STATUS]\nDie Maker: [DIE_MAKER]\nSupplier Ref: [SUPPLIER_REF]",
