<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{D1E71820-A1E4-4D2A-98F1-42C61DE8A100}</ProjectGuid>
        <ProjectVersion>20.2</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Application</AppType>
        <MainSource>DieVix.dpr</MainSource>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win32)'!=''">
        <Cfg_1_Win32>true</Cfg_1_Win32>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>dcu</DCC_DcuOutput>
        <DCC_ExeOutput>bin</DCC_ExeOutput>
        <DCC_UnitSearchPath>src\Engine;src\Domain;src\Database;src\Repositories;src\Services;src\Forms;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
        <SanitizedProjectName>DieVix</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_UsePackage>vcl;rtl;vclx;dbrtl;FireDAC;FireDACCommon;FireDACCommonDriver;FireDACIBDriver;FireDACMySQLDriver;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="src\Engine\DieVix.CalculationEngine.pas"/>
        <DCCReference Include="src\Domain\DieVix.Domain.pas"/>
        <DCCReference Include="src\Database\DieVix.ConnectionManager.pas"/>
        <DCCReference Include="src\Repositories\DieVix.Repositories.pas"/>
        <DCCReference Include="src\Services\DieVix.MasterDataService.pas"/>
        <DCCReference Include="src\Forms\frmMain.pas">
            <Form>frmMain</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmCylinderMaster.pas">
            <Form>frmCylinderMaster</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmMachineMaster.pas">
            <Form>frmMachineMaster</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmMachineCylinderMatrix.pas">
            <Form>frmMachineCylinderMatrix</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmCustomerMaster.pas">
            <Form>frmCustomerMaster</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmMediaMaster.pas">
            <Form>frmMediaMaster</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmDieStatusMaster.pas">
            <Form>frmDieStatusMaster</Form>
        </DCCReference>
        <DCCReference Include="src\Forms\frmSettings.pas">
            <Form>frmSettings</Form>
        </DCCReference>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DieVix.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
